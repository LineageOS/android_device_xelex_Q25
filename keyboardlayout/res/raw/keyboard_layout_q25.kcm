#
# Q25 physical keyboard layout overlay.
#
# Combined on top of the base Q25_keyboard.kcm so that the printed Alt layer
# (digits and symbols) survives the framework's per-key combine, which would
# otherwise be wiped by the default English-US physical keyboard overlay.
#

type OVERLAY

### Basic QWERTY keys ###

key A {
    label:                              'A'
    base:                               'a'
    shift, capslock:                    'A'
    shift+capslock:                     'a'
    alt:                                '*'
}

key B {
    label:                              'B'
    base:                               'b'
    shift, capslock:                    'B'
    shift+capslock:                     'b'
    alt:                                '!'
}

key C {
    label:                              'C'
    number:                             '9'
    base:                               'c'
    shift, capslock:                    'C'
    alt:                                '9'
    shift+capslock:                     'c'
}

key D {
    label:                              'D'
    number:                             '5'
    base:                               'd'
    shift, capslock:                    'D'
    shift+capslock:                     'd'
    alt:                                '5'
}

key E {
    label:                              'E'
    number:                             '2'
    base:                               'e'
    shift, capslock:                    'E'
    alt:                                '2'
    shift+capslock:                     'e'
}

key F {
    label:                              'F'
    number:                             '6'
    base:                               'f'
    shift, capslock:                    'F'
    shift+capslock:                     'f'
    alt:                                '6'
}

key G {
    label:                              'G'
    base:                               'g'
    shift, capslock:                    'G'
    shift+capslock:                     'g'
    alt:                                '/'
}

key H {
    label:                              'H'
    base:                               'h'
    shift, capslock:                    'H'
    shift+capslock:                     'h'
    alt:                                ':'
}

key I {
    label:                              'I'
    base:                               'i'
    shift, capslock:                    'I'
    alt:                                '-'
    shift+capslock:                     'i'
}

key J {
    label:                              'J'
    base:                               'j'
    shift, capslock:                    'J'
    shift+capslock:                     'j'
    alt:                                ';'
}

key K {
    label:                              'K'
    base:                               'k'
    shift, capslock:                    'K'
    shift+capslock:                     'k'
    alt:                                '\''
}

key L {
    label:                              'L'
    base:                               'l'
    shift, capslock:                    'L'
    shift+capslock:                     'l'
    alt:                                '"'
}

key M {
    label:                              'M'
    base:                               'm'
    shift, capslock:                    'M'
    shift+capslock:                     'm'
    alt:                                '.'
}

key N {
    label:                              'N'
    base:                               'n'
    shift, capslock:                    'N'
    alt:                                ','
    shift+capslock:                     'n'
}

key O {
    label:                              'O'
    base:                               'o'
    shift, capslock:                    'O'
    shift+capslock:                     'o'
    alt:                                '+'
}

key P {
    label:                              'P'
    base:                               'p'
    shift, capslock:                    'P'
    shift+capslock:                     'p'
    alt:                                '@'
}

key Q {
    label:                              'Q'
    base:                               'q'
    shift, capslock:                    'Q'
    shift+capslock:                     'q'
    alt:                                '#'
}

key R {
    label:                              'R'
    number:                             '3'
    base:                               'r'
    shift, capslock:                    'R'
    shift+capslock:                     'r'
    alt:                                '3'
}

key S {
    label:                              'S'
    number:                             '4'
    base:                               's'
    shift, capslock:                    'S'
    alt:                                '4'
    shift+capslock:                     's'
}

key T {
    label:                              'T'
    base:                               't'
    shift, capslock:                    'T'
    shift+capslock:                     't'
    alt:                                '('
}

key U {
    label:                              'U'
    base:                               'u'
    shift, capslock:                    'U'
    shift+capslock:                     'u'
    alt:                                '_'
}

key V {
    label:                              'V'
    base:                               'v'
    shift, capslock:                    'V'
    shift+capslock:                     'v'
    alt:                                '?'
}

key W {
    label:                              'W'
    number:                             '1'
    base:                               'w'
    shift, capslock:                    'W'
    shift+capslock:                     'w'
    alt:                                '1'
}

key X {
    label:                              'X'
    number:                             '8'
    base:                               'x'
    shift, capslock:                    'X'
    shift+capslock:                     'x'
    alt:                                '8'
}

key Y {
    label:                              'Y'
    base:                               'y'
    shift, capslock:                    'Y'
    shift+capslock:                     'y'
    alt:                                ')'
}

key Z {
    label:                              'Z'
    number:                             '7'
    base:                               'z'
    shift, capslock:                    'Z'
    shift+capslock:                     'z'
    alt:                                '7'
}
key SPACE {
    label:                              ' '
    number:                             ' '
    base:                               ' '
    shift:                              ' '
    alt:                                '\uef01'
    shift+alt:                          '\uef01'
}

key ENTER {
    label:                              '\n'
    number:                             '\n'
    base:                               '\n'
    shift:                              '\n'
    alt:                                '\n'
    shift+alt:                          '\n'
}

key 0 {
    label:                              '0'
    number:                             '0'
    base:                               '0'
    shift:                              '0'
    alt:                                '0'
    shift+alt:                          '0'
}
